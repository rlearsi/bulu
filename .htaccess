# Bloqueia acesso externo aos scripts e daemons exclusivos de autoridade local
<FilesMatch "(^authority-daemon\.sh$|^authority-local\.js$)">
    <IfVersion >= 2.4>
        Require local
    </IfVersion>
    <IfVersion < 2.4>
        Order Deny,Allow
        Deny from all
        Allow from 127.0.0.1 ::1 localhost
    </IfVersion>
</FilesMatch>

